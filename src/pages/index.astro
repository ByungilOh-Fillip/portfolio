---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Developer Portfolio">
	<section class="min-h-[80vh] flex flex-col justify-center items-center text-center">
		<h1 class="text-5xl md:text-7xl font-bold tracking-tighter mb-6">
			문제를 이해하고,<br/>
			구조를 설계하며,<br/>
			직접 구현하고 개선하는 개발자.
		</h1>
		<p class="text-gray-400 text-lg md:text-xl max-w-2xl mt-8">
			Welcome to my portfolio. Hover at the top of the screen to navigate.
		</p>
	</section>
</Layout>
